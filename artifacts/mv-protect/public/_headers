# En-têtes HTTP — cache et sécurité
# Appliqués par Replit au déploiement (Cloudflare/CDN en frontal)

# Assets Vite hashés — immutables (1 an)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fichiers statiques à rafraîchir régulièrement
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

# HTML — toujours revalidé
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# En-têtes de sécurité sur toutes les routes
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
